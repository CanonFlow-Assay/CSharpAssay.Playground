        {"id": "late-credit", "input": ["quote", "screen", "debit", "escrow", "timeout", "unknown", "credit", "release-settled"], "expected": "quote,screen,debit,hold-escrow,submit-credit,reconcile-credit,none,release-settled,none|settled"},
        {"id": "definitive-nonpayment", "input": ["quote", "screen", "debit", "escrow", "nonpayment", "timeout", "release-unwind", "refund-posted"], "expected": "quote,screen,debit,hold-escrow,submit-credit,release-unwind,reconcile-release,refund,none|refunded"},
        {"id": "foreign-payout", "input": ["quote", "screen", "debit", "escrow", "foreign-nonpayment"], "expected": "quote,screen,debit,hold-escrow,submit-credit,none|pending"},
        {"id": "credit-after-refund", "input": ["quote", "screen", "debit", "escrow", "nonpayment", "release-unwind", "refund-posted", "credit"], "expected": "quote,screen,debit,hold-escrow,submit-credit,release-unwind,refund,none,review|disputed"},
        {"id": "nonpayment-after-settlement", "input": ["quote", "screen", "debit", "escrow", "credit", "release-settled", "nonpayment"], "expected": "quote,screen,debit,hold-escrow,submit-credit,release-settled,none,review|disputed"},
        {"id": "expired-sanctions-clearance", "input": ["quote", "hold", "timeout", "late-clear"], "expected": "quote,screen,review,review,none|rejected"},
        {"id": "escrow-never-held", "input": ["quote", "screen", "debit", "no-escrow", "timeout", "refund-posted"], "expected": "quote,screen,debit,hold-escrow,refund,reconcile-refund,none|refunded"},
        {"id": "debit-and-escrow-timeouts", "input": ["quote", "screen", "timeout", "debit", "timeout"], "expected": "quote,screen,debit,reconcile-debit,hold-escrow,reconcile-escrow|awaiting-escrow"},
        {"id": "failed-release", "input": ["quote", "screen", "debit", "escrow", "nonpayment", "release-failed", "release-unwind"], "expected": "quote,screen,debit,hold-escrow,submit-credit,release-unwind,review,none|partner-review"}
